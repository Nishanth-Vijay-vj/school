# Supabase Configuration (Required for Live Production Cloud Sync & File Uploads)
# Get these from your Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional Custom Admin Passcode (Default is UMA@2026 if not using Supabase Auth)
VITE_ADMIN_PASSCODE=UMA@2026
